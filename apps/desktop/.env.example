# API의 DESKTOP_API_KEY와 같은 값 (apps/api/.env). 빌드할 때 앱에 들어간다.
VITE_API_KEY=
# API 주소 (기본 http://localhost:4000)
# VITE_API_URL=

# 배포용 앱(tauri build)이 배포한 서버를 보게 하려면, 같은 폴더에 .env.production 파일을 만들고
# 거기에 VITE_API_URL(배포한 API 주소)과 VITE_API_KEY(배포한 API의 DESKTOP_API_KEY)를 적는다.
# 개발(tauri dev)은 이 .env만 읽으므로 계속 localhost를 본다.
