# docker-compose.yml의 로컬 Postgres
DATABASE_URL=postgres://adhd:adhd@localhost:5432/adhd_irection

# GitHub 커밋 동기화용 토큰 (private·조직 레포를 읽으려면 repo 권한 필요).
# 비워 두면 동기화를 건너뛴다. gh CLI에 로그인돼 있으면 `gh auth token` 값을 쓸 수 있다.
GITHUB_TOKEN=
# 첫 동기화 때 거슬러 올라갈 일수 (기본 730)
# GITHUB_BACKFILL_DAYS=730

# Notion 편집 동기화용 토큰 (Notion 통합의 "내부 통합 시크릿").
# 비워 두면 동기화를 건너뛴다. 감시할 페이지는 Notion에서 그 통합에 공유(연결)한 것으로 정해진다.
NOTION_TOKEN=

# ── 인증 ──────────────────────────────────────────────
# 세션 토큰 서명 키. 아무도 모르는 긴 임의의 문자열 (예: openssl rand -base64 48)
SESSION_SECRET=
# 데스크톱 앱이 보내는 키. apps/desktop/.env의 VITE_API_KEY와 같은 값
DESKTOP_API_KEY=
# 카카오 개발자 콘솔 → 앱 키 → REST API 키
KAKAO_REST_API_KEY=
# 카카오 로그인 → 보안 → 클라이언트 시크릿을 켰을 때만
KAKAO_CLIENT_SECRET=
# 카카오 콘솔의 Redirect URI에 등록한 주소와 같아야 함 (기본 http://localhost:4000/auth/kakao/callback)
# KAKAO_REDIRECT_URI=
# 로그인 후 돌아갈 웹 주소 (기본 http://localhost:3000)
# WEB_URL=
